{
  "name": "server-wallet-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=@polygonlabs/source --env-file-if-exists=.env.local --import tsx server/main.ts",
    "dev:worker": "vite build && wrangler dev --port 5191",
    "keygen": "node --import tsx server/keygen.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "build": "pnpm typecheck && vite build",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@polygonlabs/oms-server-wallet-sdk": "workspace:*",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/react": "0.1.0-beta.16",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "wrangler": "4.120.1"
  }
}
