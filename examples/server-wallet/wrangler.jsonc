{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oms-server-wallet-example",
  "main": "server/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@polygonlabs/oms-server-wallet-sdk": "../../packages/oms-server-wallet/src/index.ts"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/oidc/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DEMO", "class_name": "Demo" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Demo"] }],
  "observability": { "enabled": true }
}
