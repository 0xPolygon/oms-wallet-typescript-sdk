# Copy to .env.local. `pnpm --filter server-wallet-example keygen` prints a fresh
# OIDC_PRIVATE_JWK and ENCRYPTION_KEY.
OMS_PUBLISHABLE_KEY=
# The issuer registered in your WaaS project. WaaS fetches its discovery document and JWKS,
# so it must be public: this server serves both, so a tunnel URL to it works.
OIDC_ISSUER=
OIDC_AUDIENCE=
# ES256 (P-256) private JWK whose public half the issuer's JWKS publishes.
OIDC_PRIVATE_JWK=
# 32 random bytes, base64: encrypts durable wallet state.
ENCRYPTION_KEY=
# Optional: comma-separated PCR0s (needed for pk_dev_* / pk_local_* keys).
TRUSTED_PCR0S=
PORT=5190
